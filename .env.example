# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF
# Adminlarning Telegram ID lari (vergul bilan)
ADMIN_IDS=111111111,222222222
# (ixtiyoriy) Yangi so'rovlar yuboriladigan agentlar guruhi ID si, masalan -1001234567890
AGENTS_CHAT_ID=
# SQLite fayl yo'li
DB_PATH=data/bot.db

# ===== Qo'ng'iroq userbot (python -m caller) =====
# https://my.telegram.org -> API development tools (bepul)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Session fayl nomi (birinchi ishga tushirishda telefon va kod so'raladi)
SESSION_NAME=data/my_account
# Taxallus:kontakt (username, +telefon yoki ID), vergul bilan
CALL_CONTACTS=ada:@adajonim_username
# Ovoz: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak)
TTS_VOICE=uz-UZ-SardorNeural
# Matn necha marta o'qilsin
CALL_REPEAT=2
# Javob berishni necha soniya kutish
CALL_RING_TIMEOUT=45
# Xabardan keyin javobni necha soniya tinglab, sizga yetkazsin (0 = o'chirilgan)
CALL_LISTEN_SECONDS=20
