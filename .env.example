# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF
# Adminlarning Telegram ID lari (vergul bilan)
ADMIN_IDS=111111111,222222222
# (ixtiyoriy) Yangi so'rovlar yuboriladigan agentlar guruhi ID si, masalan -1001234567890
AGENTS_CHAT_ID=
# SQLite fayl yo'li
DB_PATH=data/bot.db

# ===== Qo'ng'iroq userbot (python -m caller) =====
# https://my.telegram.org -> API development tools (bepul)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Session fayl nomi (birinchi ishga tushirishda telefon va kod so'raladi)
SESSION_NAME=data/my_account
# Taxallus:kontakt (username, +telefon yoki ID), vergul bilan
CALL_CONTACTS=ada:@adajonim_username
# Ovoz: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak)
TTS_VOICE=uz-UZ-SardorNeural
# Matn necha marta o'qilsin
CALL_REPEAT=2
# Javob berishni necha soniya kutish
CALL_RING_TIMEOUT=45
# Xabardan keyin javobni necha soniya tinglab, sizga yetkazsin (0 = o'chirilgan)
CALL_LISTEN_SECONDS=20

# ===== Robux do'kon bot (python -m robux) =====
# @BotFather dan yangi bot tokeni
ROBUX_BOT_TOKEN=
# ADMIN_IDS (yuqorida) — chek tasdiqlaydigan adminlar. ID ni botga /myid yozib bilasiz
SHOP_NAME=DENZE Robux
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_HOLDER=Ism Familiya
SUPPORT_CONTACT=@sizning_username
# Claude AI maslahatchi: https://console.anthropic.com -> API Keys (bo'sh bo'lsa AI o'chadi)
ANTHROPIC_API_KEY=
# Model (standart claude-opus-5-5; arzonroq: claude-haiku-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Bir mijoz kuniga nechta AI savol bera oladi (xarajatni cheklash)
AI_DAILY_LIMIT=30
# Do'kon ish vaqti (Toshkent vaqti); bu vaqtdan tashqari buyurtma qabul qilinmaydi
SHOP_OPEN=15:00
SHOP_CLOSE=23:59
