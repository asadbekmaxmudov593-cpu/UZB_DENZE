[
 {
  "t0": 6.35,
  "t1": 11.83,
  "text": "Assalomu alaykum! Men Asadbek, 54-maktabning 8-E sinfida oʻqiyman."
 },
 {
  "t0": 11.83,
  "t1": 15.963,
  "text": "Bugun — 18-noyabr, Davlat bayrogʻimiz kuni!"
 },
 {
  "t0": 16.25,
  "t1": 21.3,
  "text": "1991-yil 18-noyabrda Davlat bayrogʻi qonuni qabul qilingan."
 },
 {
  "t0": 21.3,
  "t1": 25.0,
  "text": "Moviy — mangu osmon va obihayot ramzi."
 },
 {
  "t0": 25.0,
  "t1": 28.25,
  "text": "Oq — tinchlik va poklik ramzi."
 },
 {
  "t0": 28.25,
  "t1": 32.1,
  "text": "Yashil — yangilanayotgan tabiat ramzi."
 },
 {
  "t0": 32.1,
  "t1": 35.4,
  "text": "Qizil chiziqlar — hayotiy kuch."
 },
 {
  "t0": 35.4,
  "t1": 38.65,
  "text": "Yarim oy — mustaqillik ramzi."
 },
 {
  "t0": 38.65,
  "t1": 42.383,
  "text": "12 yulduz — qadimiy quyosh yil hisobi."
 },
 {
  "t0": 52.95,
  "t1": 56.083,
  "text": "Bayrogʻimiz — gʻururimiz!"
 },
 {
  "t0": 56.1,
  "t1": 58.967,
  "text": "Bayramingiz muborak!"
 }
]